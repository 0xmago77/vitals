# Vitals runtime configuration. Production copy: /etc/vitals/vitals.env
# (root:vitals 0640), read by systemd (EnvironmentFile=) and, for one-off CLI
# runs, by `set -a; . /etc/vitals/vitals.env`. Plain KEY=value lines only: no
# quotes, no spaces, no `export`. An empty value means "use the built-in
# default". No secrets belong here: the signing key lives in the file named by
# VITALS_KEY_FILE.

# --- service ---------------------------------------------------------------
# Public URL that the agent card, A2A, MCP and deliverable links advertise.
VITALS_BASE_URL=https://vitals.43-165-190-110.sslip.io
# Listen address; keep it on loopback, Caddy proxies the public host here.
VITALS_HOST=127.0.0.1
# Listen port (Caddy's reverse_proxy target).
VITALS_PORT=9000
# SQLite state and deliverables; must stay /var/lib/vitals (the unit's only writable path).
VITALS_DATA_DIR=/var/lib/vitals
# File holding the agent wallet's hex private key (root:vitals 0640, placed by the operator); empty = read-only, no signing.
VITALS_KEY_FILE=/etc/vitals/wallet.key
# 1 = send real transactions (ERC-8183 submit/settle, keeper); 0 = every write is a dry run.
VITALS_LIVE=0
# Chain id; 56 is BSC mainnet (a fork of it keeps 56).
VITALS_CHAIN_ID=56
# Requests per minute per client IP on /a2a, /mcp and /api/hf.
VITALS_RATE_LIMIT_PER_MINUTE=60

# --- identity (ERC-8004) -----------------------------------------------------
# Agent ID after registration; empty = take agentId from config/agent.json. Set it here once known.
VITALS_AGENT_ID=
# Owner wallet shown in the card; empty = config/agent.json owner, else 0x15A97307cAA68C24E4b5a0b83D331A6AA1EA195F.
VITALS_OWNER=

# --- RPC (comma-separated URLs, tried in order with failover) ---------------
# Head reads; empty = bsc-dataseed, publicnode, bloXroute, bsc-dataseed1, blockrazor, blastapi (see vitals/config.py).
VITALS_RPC_HEAD=
# Archive reads at a pinned block; empty = bsc-mainnet.public.blastapi.io, 1rpc.io/bnb.
VITALS_RPC_ARCHIVE=
# eth_getLogs; empty = publicnode, bloXroute, blockrazor, 1rpc, blastapi.
VITALS_RPC_LOGS=
# Raw transaction broadcast; empty = same as VITALS_RPC_HEAD.
VITALS_RPC_WRITE=
# Per-request timeout in seconds.
VITALS_RPC_TIMEOUT=10
# Extra passes over the whole endpoint list before a call fails.
VITALS_RPC_RETRIES=2

# --- ERC-8183 seller ----------------------------------------------------------
# Price per checkup in U (18 decimals on chain).
VITALS_PRICE_U=0.01
# Quote validity in seconds (capped at 900).
VITALS_QUOTE_TTL=900
# Refuse any write when the gas price is above this many gwei.
VITALS_GAS_PRICE_CAP_GWEI=3
# Refuse any write that would leave less than this much BNB in the wallet.
VITALS_BNB_RESERVE=0.002
# 1 = let the bnbagent SDK use its paymaster for gas.
VITALS_USE_PAYMASTER=0
# 1 = run the chain watcher (needs a key); 0 = never pick up jobs.
VITALS_WATCH=1
# Seconds between watcher ticks.
VITALS_WATCH_INTERVAL=15
# First block for the JobFunded log scan on an empty database; empty = head - 2000.
VITALS_WATCH_FROM_BLOCK=
# First job id for the job scan on an empty database; empty = counter - 2000.
VITALS_WATCH_FROM_JOB=
# Block window per eth_getLogs request.
VITALS_LOG_WINDOW=5000
# 1 = settle submitted jobs automatically once the review window has passed.
VITALS_AUTO_SETTLE=1

# --- keeper (own Venus position: BNB collateral, USDT debt) ------------------
# 1 = run the daily keeper cycle inside the service. Turn on only after `keeper open`.
VITALS_KEEPER=0
# UTC hour in which the daily cycle runs (at a per-wallet randomised minute).
VITALS_KEEPER_HOUR_UTC=9
# Health factor the keeper steers back to.
VITALS_KEEPER_TARGET_HF=2.0
# Below this HF, repay back to the target.
VITALS_KEEPER_LOW_HF=1.85
# Above this HF, borrow back to the target.
VITALS_KEEPER_HIGH_HF=2.15
# Never borrow if the HF afterwards would be below this.
VITALS_KEEPER_MIN_BORROW_HF=1.9
# Below this HF, repay all USDT on hand.
VITALS_KEEPER_EMERGENCY_HF=1.3
# Largest single borrow, in USDT.
VITALS_KEEPER_MAX_BORROW_PER_TX=3
# Total USDT debt cap.
VITALS_KEEPER_DEBT_CAP=5
# Minimum maintenance repay on top of accrued interest, in USDT.
VITALS_KEEPER_MAINTENANCE_MIN=0.01
# Maintenance repay when no keeper transaction happened for this many hours.
VITALS_KEEPER_IDLE_HOURS=20

# --- contract overrides (empty = BSC mainnet defaults) ------------------------
# ERC-8004 IdentityRegistry; default 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432.
VITALS_IDENTITY_REGISTRY=
# ERC-8183 AgenticCommerce; default 0xea4daa3100a767e86fded867729ae7446476eba6.
VITALS_COMMERCE=
# ERC-8183 EvaluatorRouter; default 0x51895229e12f9876011789b04f8698af06ccd6da.
VITALS_ROUTER=
# ERC-8183 OptimisticPolicy; default 0x9c01845705b3078aa2e8cff7520a6376fd766de5.
VITALS_POLICY=
# Payment token U; default 0xcE24439F2D9C6a2289F741120FE202248B666666.
VITALS_PAYMENT_TOKEN=
# Venus Core Pool Comptroller; default 0xfD36E2c2a6789Db23113685031d7F16329158384.
VITALS_COMPTROLLER=
# Multicall3; default 0xcA11bde05977b3631167028862bE2a173976CA11.
VITALS_MULTICALL=
